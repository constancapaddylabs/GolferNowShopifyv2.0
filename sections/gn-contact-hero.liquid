<style>
  #shopify-section-{{ section.id }} .gn-contact-hero {
    background: {{ section.settings.background_color | default: '#1d3d2a' }};
    color: {{ section.settings.text_color | default: '#ffffff' }};
    padding: {{ section.settings.padding_top | default: 80 }}px 32px {{ section.settings.padding_bottom | default: 80 }}px;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .gn-contact-hero__inner {
    max-width: 700px;
    margin: 0 auto;
  }
  #shopify-section-{{ section.id }} .gn-contact-hero__eyebrow {
    margin: 0 0 14px;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: {{ section.settings.accent_color | default: '#ec7901' }};
  }
  #shopify-section-{{ section.id }} .gn-contact-hero__heading {
    margin: 0 0 18px;
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-weight: 700;
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: {{ section.settings.text_color | default: '#ffffff' }};
  }
  #shopify-section-{{ section.id }} .gn-contact-hero__rule {
    width: 44px;
    height: 3px;
    border-radius: 2px;
    margin: 0 auto 20px;
    background: {{ section.settings.accent_color | default: '#ec7901' }};
  }
  #shopify-section-{{ section.id }} .gn-contact-hero__description {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.55;
    opacity: 0.85;
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .gn-contact-hero__heading {
      font-size: 2rem;
    }
  }
</style>

<div class="gn-contact-hero">
  <div class="gn-contact-hero__inner">
    {%- if section.settings.eyebrow_text != blank -%}
      <p class="gn-contact-hero__eyebrow">{{ section.settings.eyebrow_text }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="gn-contact-hero__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
    <div class="gn-contact-hero__rule"></div>
    {%- if section.settings.description != blank -%}
      <p class="gn-contact-hero__description">{{ section.settings.description }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Contact hero",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow_text", "label": "Eyebrow text", "default": "Get in touch" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We're here to help." },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Questions about an order, a product, or your practice routine? Send us a message and we'll get back to you within one business day." },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#1d3d2a" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#ec7901" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 150, "step": 5, "unit": "px", "label": "Top padding", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 150, "step": 5, "unit": "px", "label": "Bottom padding", "default": 80 }
  ],
  "presets": [
    { "name": "Contact hero" }
  ]
}
{% endschema %}
